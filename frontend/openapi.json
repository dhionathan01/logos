          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Liveness Api Health Live Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/health/ready": {
